{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CvijaNIk/CivicTrace/blob/main/schemas/evidence-passport.schema.json",
  "title": "CivicTrace Evidence Passport 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "original_record_id": {
          "type": "string",
          "minLength": 1
        },
        "original_file_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "reference",
        "collected_at",
        "original_record_id",
        "original_file_sha256",
        "snapshot_version",
        "license"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "facts": {
      "type": "object"
    },
    "computation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "observed_result": {}
      },
      "required": [
        "expression",
        "parameters",
        "observed_result"
      ]
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "required": [
        "description",
        "value"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "allegations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "source",
    "rule",
    "facts",
    "computation",
    "benchmark",
    "limitations",
    "uncertainty",
    "interpretation",
    "allegations",
    "verification_steps"
  ]
}
