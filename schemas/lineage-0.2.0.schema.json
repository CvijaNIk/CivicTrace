{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "civictrace-lineage/1"
    },
    "status": {
      "enum": [
        "complete-synthetic",
        "legacy-incomplete"
      ]
    },
    "synthetic_only": {
      "const": true
    },
    "analytics_enabled": {
      "const": false
    },
    "original_file_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "decompressed_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "original_pointer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "collection_time": {
      "type": "string",
      "format": "date-time"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "redistribution": {
          "type": "string",
          "minLength": 1
        },
        "privacy_review": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "registry_transformation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "license",
        "evidence",
        "attribution",
        "redistribution",
        "privacy_review",
        "registry_transformation"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "sha256",
          "media_type"
        ]
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "implementation_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "operation",
          "version",
          "inputs",
          "output",
          "implementation_sha256"
        ]
      }
    },
    "environment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": {
              "type": "string",
              "minLength": 1
            },
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "packages": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "python",
            "implementation",
            "platform",
            "packages"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "contract",
    "status",
    "synthetic_only",
    "analytics_enabled",
    "original_file_sha256",
    "decompressed_sha256",
    "original_pointer",
    "source_date",
    "collection_time",
    "rights",
    "artifacts",
    "transformations",
    "environment",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civictrace.invalid/lineage-0.2.0.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete-synthetic"
          }
        }
      },
      "then": {
        "properties": {
          "original_file_sha256": {
            "type": "string"
          },
          "decompressed_sha256": {
            "type": "string"
          },
          "original_pointer": {
            "type": "string"
          },
          "artifacts": {
            "minItems": 2
          },
          "transformations": {
            "minItems": 1
          },
          "environment": {
            "type": "object"
          }
        }
      }
    }
  ]
}
